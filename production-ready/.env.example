# Production Environment Variables Template
# Copy this to .env and fill in your real values
# DO NOT commit .env to Git!

NODE_ENV=production
PORT=3000

# Required
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/herbserver?retryWrites=true&w=majority

# Security Configuration
# JWT Secret - CHANGE THIS TO A RANDOM STRONG SECRET IN PRODUCTION!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# CORS Allowed Origins (comma-separated)
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# Optional - only if Shiprocket features are used
SHIPROCKET_API_EMAIL=api.herbonnaturals@gmail.com
SHIPROCKET_API_PASSWORD=your_password_here
